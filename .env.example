# Copy to .env and adjust. Every setting the app reads is listed here with a
# comment directly above it; tests/unit/test_env_example.py fails otherwise.

# ---------------------------------------------------------------- runtime
# Deployment environment: dev | test | prod.
APP_ENV=dev
# Minimum log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Log line format: json (one JSON object per line) | text (human readable).
LOG_FORMAT=json

# ---------------------------------------------------------------- LLM
# Completion backend: none (offline rules + templates, no network) | ollama | openai_compatible.
LLM_PROVIDER=none
# OpenAI-compatible base URL. Ollama serves one at /v1. From inside Docker use http://host.docker.internal:11434/v1.
LLM_BASE_URL=http://localhost:11434/v1
# Model that plans, extracts claims and writes reports.
LLM_MODEL=qwen2.5:7b
# API key for openai_compatible providers. Leave empty for Ollama. Never commit a real key.
LLM_API_KEY=
# Per-request timeout for LLM calls, in seconds (0 < value <= 600).
LLM_TIMEOUT_SECONDS=120
# Model used as the evaluation judge. Should differ from LLM_MODEL to limit self-preference bias.
JUDGE_MODEL=llama3.1:8b

# ---------------------------------------------------------------- embeddings
# Embedding backend: hash (deterministic, offline, tests/CI only) | ollama.
EMBEDDING_PROVIDER=hash
# Embedding model name when EMBEDDING_PROVIDER=ollama. bge-m3 handles Georgian.
EMBEDDING_MODEL=bge-m3
# Vector dimension stored in pgvector. Must match the model (bge-m3: 1024).
EMBEDDING_DIM=1024

# ---------------------------------------------------------------- storage
# Async SQLAlchemy URL for PostgreSQL 16 + pgvector.
DATABASE_URL=postgresql+asyncpg://researchai:researchai@localhost:5434/researchai

# ---------------------------------------------------------------- docker compose only
# Credentials for the local Postgres container. Development values only.
POSTGRES_USER=researchai
# Password for the local Postgres container. Development value only.
POSTGRES_PASSWORD=researchai
# Database created on first start of the Postgres container.
POSTGRES_DB=researchai
# LLM_BASE_URL as seen from inside the backend container (localhost there is the container itself).
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
# Host port for Postgres (localhost only). Not 5432/5433 to avoid clashing with other local databases.
DB_HOST_PORT=5434
# Host port for the API (localhost only).
API_HOST_PORT=8100
